{
    "version": 2,
    "framework": "vite",
    "outputDirectory": "client/dist",
    "functions": {
        "api/index.js": {
            "maxDuration": 60,
            "memory": 1024
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
